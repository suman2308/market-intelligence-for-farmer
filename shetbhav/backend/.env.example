# ShetBhav Backend — Environment Variables
# Copy this to .env and fill in production values

# Database (PostgreSQL for production, SQLite for dev)
# For Supabase: postgresql://postgres:password@db.xxxxx.supabase.co:5432/postgres
DATABASE_URL=sqlite:///./data/shetbhav.db

# JWT Authentication
SECRET_KEY=change-this-to-a-random-64-char-string-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080  # 7 days

# CORS
BACKEND_URL=http://localhost:8000
FRONTEND_URL=http://localhost:3000

# Demo Mode (set to false in production)
DEMO_MODE=true

# Language
DEFAULT_LANGUAGE=en

# data.gov.in API (get key from https://data.gov.in)
DATA_GOV_API_KEY=
DATA_GOV_RESOURCE_ID=9ef84268-d588-465a-a308-a864a43d0070
MARKET_DATA_MODE=live
MARKET_DATA_CACHE_HOURS=24
REQUEST_TIMEOUT_SECONDS=30

# Bootstrap (set true on a fresh production database)
# Imports the real AGMARKNET CSV on first boot, then re-evaluates forecast
# models on the real data (XGBoost vs naive baseline).
IMPORT_HISTORICAL_CSV=false
TRAIN_ON_STARTUP=false

# File Uploads
MAX_UPLOAD_SIZE_MB=10

# Rate Limiting (requests per minute per IP)
RATE_LIMIT_LOGIN=10
RATE_LIMIT_API=100
