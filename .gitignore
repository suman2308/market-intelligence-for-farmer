# =========================================================
# ShetBhav — .gitignore
# Anything listed here must never appear on GitHub.
# =========================================================

# === Environment & secrets (never commit real values) ===
.env
.env.*
!.env.example
!.env.sample
*.pem
*.key
*.p12

# === Python ===
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
*.egg
.venv/
venv/
env/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.hypothesis/
.coverage
htmlcov/
.tox/

# === Databases (local runtime + test) ===
*.db
*.db-shm
*.db-wal
*.db-journal
*.sqlite
*.sqlite3
*.sqlite3-journal

# === Raw data caches (regenerated by import/sync scripts) ===
shetbhav/backend/data/*.json
shetbhav/backend/data/*.db*

# === ML artifacts (retrained/generated on first run) ===
*.joblib
*.pkl
*.model
*.onnx
shetbhav/backend/data/models/

# === Node / frontend build output ===
node_modules/
shetbhav/frontend/.next/
shetbhav/frontend/next-env.d.ts
*.tsbuildinfo
.eslintcache
out/
dist/
build/
coverage/
.vercel/
.turbo/

# === Logs ===
*.log
*.log.*
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# === OS & editor ===
.DS_Store
Thumbs.db
desktop.ini
.vscode/
.idea/
*.swp
*.swo
*~
*.rej
*.orig

# === User uploads (runtime files) ===
shetbhav/backend/uploads/

# === Local tooling / worktree artifacts ===
.freebuff/
